# Obtain from: Supabase Project Dashboard -> Project Settings -> API
# https://app.supabase.com/project/_/settings/api
# =============================================================================
# Project URL (starts with https://...)
VITE_SUPABASE_URL=https://smsauzutmqmfytlrnthc.supabase.co

# Public Anon API Key (Safe for browser / client-side)
VITE_SUPABASE_ANON_KEY=sb_publishable_oXej_1bTZDggh0JxzZ0lhg_zerhND6r

# Service Role Secret (Admin/Backend migrations only - optional for local dev)
