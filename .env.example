# CreaSync Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env TO VERSION CONTROL

# =============================================================================
# 1. AI Integration (Server-side only — never expose to client)
# =============================================================================
# Groq API Key — Used by server/groqMiddleware.js & server/groqService.js
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# =============================================================================
# 2. Production Shared Database & Auth (Supabase PostgreSQL)
# =============================================================================
# Obtain from your Supabase Project Dashboard -> Settings -> API
# https://app.supabase.com/project/_/settings/api
#
# Client Anon Key: Safe to expose in browser (Row-Level Security enforced)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Service Role Secret: For backend migrations/admin tasks ONLY
# NEVER expose this key in frontend VITE_ variables
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# Public Storage Bucket Name for Creator Portfolios & Avatars
VITE_SUPABASE_STORAGE_BUCKET=creasynq-media

# =============================================================================
# 3. Server Configuration
# =============================================================================
PORT=5173
NODE_ENV=development

