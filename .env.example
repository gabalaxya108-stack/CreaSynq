# CreaSync Environment Configuration
# DO NOT COMMIT .env TO VERSION CONTROL

# =============================================================================
# 1. AI Integration (Server-side only — Groq LLM)
# Obtain from: https://console.groq.com/keys
# =============================================================================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# =============================================================================
# 2. Supabase Cloud Configuration (Database & Auth)
# Obtain from: Supabase Project Dashboard -> Project Settings -> API
# https://app.supabase.com/project/_/settings/api
# =============================================================================
# Project URL (starts with https://...)
VITE_SUPABASE_URL=https://smsauzutmqmfytlrnthc.supabase.co

# Public Anon API Key (Safe for browser / client-side)
VITE_SUPABASE_ANON_KEY=sb_publishable_oXej_1bTZDggh0JxzZ0lhg_zerhND6r

# Service Role Secret (Admin/Backend migrations only - optional for local dev)
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name for portfolios & media
VITE_SUPABASE_STORAGE_BUCKET=creasynq-media

# =============================================================================
# 3. Server & Local Dev
# =============================================================================
PORT=5173
NODE_ENV=development

# =============================================================================
# 4. Super Admin & Judge Governance Portal
# =============================================================================
# Designated Super Admin email for server authorization
ALLOY_ADMIN_EMAIL=admin@alloy.market
# Optional provisioning secret (min 16 chars) for one-time CLI/HTTP bootstrap
ALLOY_ADMIN_PROVISION_SECRET=
# Dedicated judge evaluation account (public test account with low administrative privileges)
VITE_JUDGE_EMAIL=judge@alloy.market
VITE_JUDGE_PASSWORD=JudgeAlloy2026!